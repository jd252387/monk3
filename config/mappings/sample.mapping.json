{
  "$schema": "./mappings.schema.json",
  "root": {
    "identifier": {
      "field": "title",
      "data": {
        "type": "text",
        "phrases": [
          {
            "type": "phrase",
            "value": "book"
          }
        ]
      }
    },
    "materialType": {
      "type": "string",
      "destinationField": "material_tyewpe"
    },
    "title": {
      "type": "freetext"
    },
    "category": {
      "type": "datetime",
      "aggregatable": true,
      "searchable": false,
      "destinationField": "ds"
    },
    "price": {
      "type": "boolean",
      "destinationField": "ew"
    },
    "description": {
      "type": "freetext"
    },
    "year": {
      "type": "datetime"
    },
    "subdocuments": {
      "type": "subdocument",
      "subdocumentType": "subdoc",
      "destinationField": "subdocs"
    }
  },
  "subdoc": {
    "chapter": {
      "type": "string",
      "destinationField": "chapter",
      "aggregatable": true
    },
    "page": {
      "type": "number",
      "destinationField": "page"
    },
    "subsubdocs": {
      "type": "subdocument",
      "subdocumentType": "subsubdoc",
      "destinationField": "subsubdocs"
    }
  },
  "subsubdoc": {
    "section": {
      "type": "string",
      "destinationField": "section"
    },
    "paragraph": {
      "type": "freetext",
      "destinationField": "paragraph"
    }
  }
}
