# Mapping editor git config — baked into the JS bundle at build time.
# WARNING: everything here ships to every user of the app; use a low-privilege,
# repo-scoped token only.
# Copy to .env.local for local development.

# Clone URL of the repo holding *.mapping.json / *.virtual.json files (required).
VITE_MAPPINGS_GIT_URL=

# Branch to clone and push to; defaults to the remote's default branch.
VITE_MAPPINGS_GIT_BRANCH=

# HTTPS credentials for private repos; username defaults to the token.
VITE_MAPPINGS_GIT_USERNAME=
VITE_MAPPINGS_GIT_TOKEN=

# CORS proxy for hosts that block browser git clients (github.com, gitlab.com).
# Not needed for same-origin or CORS-enabled git servers.
# For LOCAL DEV against GitHub you can skip this entirely and instead set
# VITE_MAPPINGS_GIT_URL=/gh/<owner>/<repo>, which routes through the vite.config.ts
# `/gh` dev proxy (same-origin, keeps your token off any third-party proxy).
# Load the app from the vite dev server directly (http://localhost:5173) for this,
# not from Quinoa on :8080 (Quinoa doesn't forward the git-upload-pack POST).
VITE_MAPPINGS_GIT_CORS_PROXY=
